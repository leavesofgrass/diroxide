    --tw-note-bg: Canvas;
    --tw-status-bar-fg: ButtonText;
    --tw-status-bar-bg: ButtonFace;
    --tw-focus-fg: HighlightText;
    --tw-focus-bg: Highlight;
    --tw-highlight-yellow-fg: HighlightText;
    --tw-highlight-yellow-bg: Highlight;

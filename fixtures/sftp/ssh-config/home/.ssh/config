# A fixture for the Host lister: never anyone's real file. Every name is
# made up.
Host build
    HostName build.example
    User ada

Host nas backup-*
    HostName nas.example

Host *.example !secret.example
    User ada

Host=quoted "two words"

Match host build exec "true"
    ForwardAgent no

Host -oProxyCommand=calc
    HostName evil.example

Include config.d/*.conf
Include ~/.ssh/more/last.conf
Include missing/never.conf

Host build
    Port 2222

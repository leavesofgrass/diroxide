body { background: var(--tw-background); color: var(--tw-text); }
h1 { color: var(--tw-heading1); }
h2 { color: var(--tw-heading2); }
h3 { color: var(--tw-heading3); }
h4 { color: var(--tw-heading4); }
h5 { color: var(--tw-heading5); }
h6 { color: var(--tw-heading6); }
a { color: var(--tw-link); text-decoration: underline; }
code { color: var(--tw-code); background: var(--tw-code-background); }
pre { color: var(--tw-text); background: var(--tw-code-background); }
pre code { background: transparent; }
blockquote { color: var(--tw-quote); border-left: 3px solid var(--tw-dim-text); padding-left: 0.75em; }
hr { border: 0; border-top: 1px solid var(--tw-border); }
th, td { border: 1px solid var(--tw-control-border); }
.tw-dim { color: var(--tw-dim-text); }
.tw-error { color: var(--tw-error); font-weight: bold; }
.tw-panel { background: var(--tw-surface); color: var(--tw-text); }
::selection { color: var(--tw-selection-fg); background: var(--tw-selection-bg); }
:focus-visible { outline: 2px solid var(--tw-focus-bg); outline-offset: 1px; box-shadow: 0 0 0 1px var(--tw-focus-inner); }
.tw-spoken-word { color: var(--tw-spoken-word-fg); background: var(--tw-spoken-word-bg); font-weight: var(--tw-spoken-word-weight); text-decoration: var(--tw-spoken-word-decoration); font-style: var(--tw-spoken-word-style); }
.tw-spoken-sentence { color: var(--tw-spoken-sentence-fg); background: var(--tw-spoken-sentence-bg); font-weight: var(--tw-spoken-sentence-weight); text-decoration: var(--tw-spoken-sentence-decoration); font-style: var(--tw-spoken-sentence-style); }
.tw-find-hit { color: var(--tw-find-hit-fg); background: var(--tw-find-hit-bg); font-weight: var(--tw-find-hit-weight); text-decoration: var(--tw-find-hit-decoration); font-style: var(--tw-find-hit-style); }
.tw-current-find-hit { color: var(--tw-current-find-hit-fg); background: var(--tw-current-find-hit-bg); font-weight: var(--tw-current-find-hit-weight); text-decoration: var(--tw-current-find-hit-decoration); font-style: var(--tw-current-find-hit-style); }
.tw-bookmark { color: var(--tw-bookmark-fg); background: var(--tw-bookmark-bg); font-weight: var(--tw-bookmark-weight); text-decoration: var(--tw-bookmark-decoration); font-style: var(--tw-bookmark-style); }
.tw-note { color: var(--tw-note-fg); background: var(--tw-note-bg); font-weight: var(--tw-note-weight); text-decoration: var(--tw-note-decoration); font-style: var(--tw-note-style); }
.tw-status-bar { color: var(--tw-status-bar-fg); background: var(--tw-status-bar-bg); font-weight: var(--tw-status-bar-weight); text-decoration: var(--tw-status-bar-decoration); font-style: var(--tw-status-bar-style); }
.tw-focus { color: var(--tw-focus-fg); background: var(--tw-focus-bg); font-weight: var(--tw-focus-weight); text-decoration: var(--tw-focus-decoration); font-style: var(--tw-focus-style); }
.tw-highlight-yellow { color: var(--tw-highlight-yellow-fg); background: var(--tw-highlight-yellow-bg); font-weight: var(--tw-highlight-yellow-weight); text-decoration: var(--tw-highlight-yellow-decoration); font-style: var(--tw-highlight-yellow-style); }
.tw-highlight-green { color: var(--tw-highlight-green-fg); background: var(--tw-highlight-green-bg); font-weight: var(--tw-highlight-green-weight); text-decoration: var(--tw-highlight-green-decoration); font-style: var(--tw-highlight-green-style); }
.tw-highlight-blue { color: var(--tw-highlight-blue-fg); background: var(--tw-highlight-blue-bg); font-weight: var(--tw-highlight-blue-weight); text-decoration: var(--tw-highlight-blue-decoration); font-style: var(--tw-highlight-blue-style); }
.tw-highlight-pink { color: var(--tw-highlight-pink-fg); background: var(--tw-highlight-pink-bg); font-weight: var(--tw-highlight-pink-weight); text-decoration: var(--tw-highlight-pink-decoration); font-style: var(--tw-highlight-pink-style); }

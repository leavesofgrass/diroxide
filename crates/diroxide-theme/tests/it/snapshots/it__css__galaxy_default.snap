---
source: crates/diroxide-theme/tests/it/css.rs
expression: default_stylesheet()
---
/* diroxide themes: Galaxy Light (light), Galaxy (dark), High Contrast (more contrast); dark unless the system says otherwise */
:root {
  color-scheme: dark;
  --tw-background: #1e1e1e;
  --tw-surface: #2a2a2a;
  --tw-text: #dadada;
  --tw-dim-text: #858585;
  --tw-heading1: #c9b6ff;
  --tw-heading2: #a98eff;
  --tw-heading3: #8aa2ff;
  --tw-heading4: #7bd0c1;
  --tw-heading5: #7bd0c1;
  --tw-heading6: #7bd0c1;
  --tw-link: #a882ff;
  --tw-code: #e0a87a;
  --tw-code-background: #2a2a2a;
  --tw-quote: #858585;
  --tw-error: #ff7b93;
  --tw-raised: #363636;
  --tw-border: #444444;
  --tw-control-border: #737373;
  --tw-panel-dim-text: #919191;
  --tw-accent: #c9b6ff;
  --tw-on-accent: #1e1e1e;
  --tw-disabled: #858585;
  --tw-caret: #dadada;
  --tw-focus-inner: #1e1e1e;
  --tw-ruler: #3c3450;
  --tw-ruler-band: #2c2835;
  --tw-difficult-word: #dadada;
  --tw-syllable-mark: #dadada;
  --tw-misspelling: #a882ff;
  --tw-lint: #dadada;
  --tw-selection-fg: #483d6b;
  --tw-selection-bg: #dadada;
  --tw-selection-weight: inherit;
  --tw-selection-decoration: none;
  --tw-selection-style: inherit;
  --tw-spoken-word-fg: #1e1e1e;
  --tw-spoken-word-bg: #c9b6ff;
  --tw-spoken-word-weight: bold;
  --tw-spoken-word-decoration: none;
  --tw-spoken-word-style: inherit;
  --tw-spoken-sentence-fg: #dadada;
  --tw-spoken-sentence-bg: #483d6b;
  --tw-spoken-sentence-weight: inherit;
  --tw-spoken-sentence-decoration: underline;
  --tw-spoken-sentence-style: inherit;
  --tw-find-hit-fg: #1e1e1e;
  --tw-find-hit-bg: #8aa2ff;
  --tw-find-hit-weight: inherit;
  --tw-find-hit-decoration: underline;
  --tw-find-hit-style: inherit;
  --tw-current-find-hit-fg: #1e1e1e;
  --tw-current-find-hit-bg: #a98eff;
  --tw-current-find-hit-weight: bold;
  --tw-current-find-hit-decoration: underline;
  --tw-current-find-hit-style: inherit;
  --tw-bookmark-fg: #7bd0c1;
  --tw-bookmark-bg: transparent;
  --tw-bookmark-weight: bold;
  --tw-bookmark-decoration: underline;
  --tw-bookmark-style: inherit;
  --tw-note-fg: #e0a87a;
  --tw-note-bg: transparent;
  --tw-note-weight: inherit;
  --tw-note-decoration: underline;
  --tw-note-style: italic;
  --tw-status-bar-fg: #1e1e1e;
  --tw-status-bar-bg: #c9b6ff;
  --tw-status-bar-weight: bold;
  --tw-status-bar-decoration: none;
  --tw-status-bar-style: inherit;
  --tw-focus-fg: #1e1e1e;
  --tw-focus-bg: #a882ff;
  --tw-focus-weight: bold;
  --tw-focus-decoration: none;
  --tw-focus-style: inherit;
  --tw-highlight-yellow-fg: #dadada;
  --tw-highlight-yellow-bg: #625518;
  --tw-highlight-yellow-weight: bold;
  --tw-highlight-yellow-decoration: none;
  --tw-highlight-yellow-style: inherit;
  --tw-highlight-green-fg: #dadada;
  --tw-highlight-green-bg: #255130;
  --tw-highlight-green-weight: bold;
  --tw-highlight-green-decoration: none;
  --tw-highlight-green-style: inherit;
  --tw-highlight-blue-fg: #dadada;
  --tw-highlight-blue-bg: #183d62;
  --tw-highlight-blue-weight: bold;
  --tw-highlight-blue-decoration: none;
  --tw-highlight-blue-style: inherit;
  --tw-highlight-pink-fg: #dadada;
  --tw-highlight-pink-bg: #623246;
  --tw-highlight-pink-weight: bold;
  --tw-highlight-pink-decoration: none;
  --tw-highlight-pink-style: inherit;
}

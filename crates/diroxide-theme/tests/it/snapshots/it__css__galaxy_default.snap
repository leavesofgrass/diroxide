@media (forced-colors: active) {
  :root {
    color-scheme: light dark;
    --tw-background: Canvas;
    --tw-surface: Canvas;
    --tw-text: CanvasText;
    --tw-dim-text: CanvasText;
    --tw-heading1: CanvasText;
    --tw-heading2: CanvasText;
    --tw-heading3: CanvasText;
    --tw-heading4: CanvasText;
    --tw-heading5: CanvasText;
    --tw-heading6: CanvasText;
